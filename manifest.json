{
   "manifest_version": 3,
   "minimum_chrome_version": "88",
   "name": "ScriptSafe",
   "version": "2.0.0.0",
   "description": "__MSG_appdescription__",
   "default_locale": "en",
   "action": {
      "default_icon": "img/IconForbidden.png",
      "default_title": "ScriptSafe",
      "default_popup": "html/popup.html"
   },
   "background": {
      "service_worker": "js/background.js",
      "type": "module"
   },
   "icons": {
      "16": "img/icon16.png",
      "24": "img/icon24.png",
      "32": "img/icon32.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
   },
   "content_scripts": [
      {
         "matches": [
            "http://*/*",
            "https://*/*"
         ],
         "js": [
            "js/jquery.js",
            "js/ss.bundle.js"
         ],
         "run_at": "document_start",
         "all_frames": true
      }
   ],
   "permissions": [
      "tabs",
      "unlimitedStorage",
      "webRequest",
      "webRequestBlocking",
      "storage",
      "notifications",
      "privacy",
      "scripting",
      "contextMenus"
   ],
   "host_permissions": [
      "http://*/*",
      "https://*/*"
   ],
   "commands": {
      "temppage": {
         "suggested_key": {
            "default": "Ctrl+Shift+S"
         },
         "description": "__MSG_hotkeystoggle__"
      },
      "removetemppage": {
         "suggested_key": {
            "default": "Ctrl+Shift+R"
         },
         "description": "__MSG_hotkeysremove__"
      },
      "removetempall": {
         "suggested_key": {
            "default": "Ctrl+Shift+Q"
         },
         "description": "__MSG_hotkeysremoveall__"
      }
   },
   "options_page": "html/options.html"
}